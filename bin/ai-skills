#!/bin/bash
set -euo pipefail

# ─────────────────────────────────────────────
# ai-skills — global CLI for the ai-skills toolkit
# https://github.com/paycrux/ai-skills
#
# Pure shell tool, independent of any agent (Claude Code / Cursor / Codex).
# Reads state written by install.sh under ~/.ai-skills.
# ─────────────────────────────────────────────

AI_SKILLS_HOME="$HOME/.ai-skills"
AI_SKILLS_REPO="$AI_SKILLS_HOME/repo"
INSTALLS_JSON="$AI_SKILLS_HOME/installs.json"
INSTALL_SH="$AI_SKILLS_REPO/install.sh"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { echo -e "${CYAN}[info]${NC} $1"; }
ok()    { echo -e "${GREEN}[ok]${NC} $1"; }
warn()  { echo -e "${YELLOW}[warn]${NC} $1"; }
error() { echo -e "${RED}[error]${NC} $1"; exit 1; }

require_repo() {
  [[ -d "$AI_SKILLS_REPO/.git" ]] \
    || error "영구 clone이 없습니다 ($AI_SKILLS_REPO). 먼저 install.sh로 설치하세요."
  [[ -f "$INSTALL_SH" ]] \
    || error "install.sh를 찾을 수 없습니다 ($INSTALL_SH). rm -rf $AI_SKILLS_REPO 후 재설치하세요."
}

# ─────────────────────────────────────────────
# ai-skills install
# ─────────────────────────────────────────────
cmd_install() {
  require_repo

  info "Pulling latest ai-skills ($AI_SKILLS_REPO)..."
  if ! git -C "$AI_SKILLS_REPO" pull --ff-only; then
    error "git pull 실패 — 오프라인이거나 원격에 접근할 수 없습니다.
  clone이 손상된 경우: rm -rf $AI_SKILLS_REPO 후 재설치하세요."
  fi

  # No args needed — install.sh prompts interactively for editor/scope when
  # --claude/--cursor/--codex and --global/--project aren't passed.
  bash "$INSTALL_SH" "$@"
}

# ─────────────────────────────────────────────
# ai-skills update
# ─────────────────────────────────────────────
cmd_update() {
  require_repo

  if [[ ! -f "$INSTALLS_JSON" ]]; then
    error "설치 기록이 없습니다. 먼저 install.sh로 설치하세요."
  fi

  # Parse filter flags: --claude / --cursor / --codex select specific modes;
  # --all skips the interactive picker and updates every recorded target.
  local -a mode_filter=()
  local all_flag=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --claude) mode_filter+=("claude"); shift ;;
      --cursor) mode_filter+=("cursor"); shift ;;
      --codex)  mode_filter+=("codex"); shift ;;
      --all)    all_flag=true; shift ;;
      *) error "알 수 없는 옵션: $1 (ai-skills help 참고)" ;;
    esac
  done

  info "Pulling latest ai-skills ($AI_SKILLS_REPO)..."
  if ! git -C "$AI_SKILLS_REPO" pull --ff-only; then
    error "git pull 실패 — 오프라인이거나 원격에 접근할 수 없습니다.
  clone이 손상된 경우: rm -rf $AI_SKILLS_REPO 후 재설치하세요."
  fi

  # Read recorded targets as TSV lines: mode<TAB>scope<TAB>target_dir
  local targets
  targets=$(python3 - "$INSTALLS_JSON" <<'PYEOF'
import json, sys, os

path = sys.argv[1]
try:
    with open(path) as f:
        data = json.load(f)
except (ValueError, OSError):
    data = []

if not isinstance(data, list):
    data = []

for e in data:
    if not isinstance(e, dict):
        continue
    mode = e.get("mode", "")
    scope = e.get("scope", "")
    target = e.get("target_dir", "")
    if mode and scope and target:
        print("\t".join([mode, scope, target]))
PYEOF
)

  if [[ -z "$targets" ]]; then
    error "기록된 설치 대상이 없습니다. 먼저 install.sh로 설치하세요."
  fi

  # Load into parallel arrays so the user (or --flags) can pick a subset by index.
  local -a all_modes=() all_scopes=() all_dirs=()
  while IFS=$'\t' read -r mode scope target; do
    [[ -z "$mode" ]] && continue
    all_modes+=("$mode")
    all_scopes+=("$scope")
    all_dirs+=("$target")
  done <<< "$targets"

  local -a sel_idx=()

  if [[ ${#mode_filter[@]} -gt 0 ]]; then
    # Non-interactive: --claude/--cursor/--codex filter the recorded targets
    local i f match
    for i in "${!all_modes[@]}"; do
      match=false
      for f in "${mode_filter[@]}"; do
        [[ "${all_modes[$i]}" == "$f" ]] && match=true && break
      done
      $match && sel_idx+=("$i")
    done
    if [[ ${#sel_idx[@]} -eq 0 ]]; then
      error "지정한 대상(${mode_filter[*]})에 해당하는 설치 기록이 없습니다."
    fi
  elif $all_flag || [[ ! -t 0 ]]; then
    # --all, or no tty to prompt on (e.g. piped/CI): update everything recorded
    sel_idx=($(seq 0 $((${#all_modes[@]} - 1))))
  else
    echo ""
    echo -e "${CYAN}업데이트할 대상을 선택하세요:${NC}"
    local i
    for i in "${!all_modes[@]}"; do
      echo "  $((i + 1))) ${all_modes[$i]} (${all_scopes[$i]}) → ${all_dirs[$i]}"
    done
    echo "  a) 전체"
    read -rp "> (예: 1 3, 또는 a) " choice

    if [[ "$choice" == "a" || "$choice" == "A" ]]; then
      sel_idx=($(seq 0 $((${#all_modes[@]} - 1))))
    else
      local token
      for token in $choice; do
        token="${token//,/}"
        [[ -z "$token" ]] && continue
        if ! [[ "$token" =~ ^[0-9]+$ ]] || (( token < 1 || token > ${#all_modes[@]} )); then
          error "잘못된 선택: $token"
        fi
        sel_idx+=($((token - 1)))
      done
      if [[ ${#sel_idx[@]} -eq 0 ]]; then
        error "선택된 대상이 없습니다."
      fi
    fi
  fi

  local total=0 failed=0
  local idx mode scope target
  for idx in "${sel_idx[@]}"; do
    mode="${all_modes[$idx]}"
    scope="${all_scopes[$idx]}"
    target="${all_dirs[$idx]}"
    ((total++))
    echo ""
    echo -e "${CYAN}━━━ Updating: ${mode}/${scope} → ${target} ━━━${NC}"

    # install.sh derives a --project target from the current working directory,
    # so run from the target's parent. Global scope ignores cwd but this is harmless.
    local workdir
    workdir="$(dirname "$target")"
    if [[ ! -d "$workdir" ]]; then
      warn "대상 디렉터리의 상위 경로가 없습니다: $workdir — 건너뜀"
      ((failed++))
      continue
    fi

    if (cd "$workdir" && bash "$INSTALL_SH" "--$mode" "--$scope" --update); then
      ok "Updated: $target"
    else
      warn "Update 실패: $target"
      ((failed++))
    fi
  done

  echo ""
  if [[ $failed -gt 0 ]]; then
    warn "완료: ${total}개 중 ${failed}개 실패"
  else
    ok "완료: ${total}개 대상 모두 업데이트됨"
  fi
}

# ─────────────────────────────────────────────
# ai-skills version
# ─────────────────────────────────────────────
read_version() { # reads VERSION="x.y.z" from stdin
  grep -m1 '^VERSION=' | cut -d'"' -f2
}

cmd_version() {
  require_repo

  local local_ver remote_ver remote_ref
  local_ver=$(read_version < "$INSTALL_SH" || true)
  [[ -z "$local_ver" ]] && local_ver="unknown"

  if git -C "$AI_SKILLS_REPO" fetch --quiet origin 2>/dev/null; then
    # Prefer the remote's default branch, fall back to origin/main
    remote_ref=$(git -C "$AI_SKILLS_REPO" rev-parse --abbrev-ref origin/HEAD 2>/dev/null || true)
    [[ -z "$remote_ref" ]] && remote_ref="origin/main"
    remote_ver=$(git -C "$AI_SKILLS_REPO" show "$remote_ref:install.sh" 2>/dev/null | read_version || true)
  else
    warn "원격 fetch 실패 — 오프라인일 수 있습니다. 로컬 버전만 표시합니다."
  fi
  [[ -z "${remote_ver:-}" ]] && remote_ver="unknown"

  echo ""
  echo -e "  ${CYAN}로컬(설치됨):${NC} v${local_ver}"
  echo -e "  ${CYAN}원격(최신):${NC}   v${remote_ver}"
  echo ""

  if [[ "$remote_ver" == "unknown" ]]; then
    warn "원격 버전을 확인하지 못했습니다."
  elif [[ "$local_ver" == "$remote_ver" ]]; then
    ok "이미 최신입니다 (v${local_ver})"
  else
    warn "업데이트 가능: v${local_ver} → v${remote_ver}. 'ai-skills update' 를 실행하세요."
  fi
}

# ─────────────────────────────────────────────
# ai-skills help
# ─────────────────────────────────────────────
cmd_help() {
  echo "Usage: ai-skills <command> [options]"
  echo ""
  echo "Commands:"
  echo "  install [options]  새 에디터(claude/cursor/codex)를 추가로 설치"
  echo "  update [options]   영구 clone을 pull하고 기록된 설치 대상을 재설치(--update)"
  echo "  version            로컬 설치 버전과 원격 최신 버전을 비교"
  echo "  help               이 도움말 출력"
  echo ""
  echo "install options (install.sh에 그대로 전달됨):"
  echo "  --claude / --cursor / --codex   설치할 에디터"
  echo "  --global / --project            설치 범위"
  echo "  --only <skills|rules|docs>      특정 항목만 설치"
  echo ""
  echo "옵션 없이 'ai-skills install'을 실행하면, 어떤 에디터·범위에"
  echo "설치할지 대화형으로 선택할 수 있습니다."
  echo ""
  echo "update options:"
  echo "  --claude   claude 대상만 업데이트"
  echo "  --cursor   cursor 대상만 업데이트"
  echo "  --codex    codex 대상만 업데이트"
  echo "  --all      확인 없이 기록된 모든 대상 업데이트"
  echo ""
  echo "옵션 없이 'ai-skills update'를 실행하면, 기록된 대상 중 어떤 것을"
  echo "업데이트할지 매번 대화형으로 선택할 수 있습니다."
}

# ─────────────────────────────────────────────
# Dispatch
# ─────────────────────────────────────────────
cmd="${1:-help}"
[[ $# -gt 0 ]] && shift
case "$cmd" in
  install) cmd_install "$@" ;;
  update)  cmd_update "$@" ;;
  version) cmd_version ;;
  help|-h|--help) cmd_help ;;
  *) error "알 수 없는 명령: $cmd (ai-skills help 참고)" ;;
esac
